# Salin ke .env lalu isi. Jangan commit .env.

# PostgreSQL (Neon). Kosongkan untuk memakai database lokal PGlite di folder .data/ (khusus pengembangan).
DATABASE_URL=

# Redis (kehadiran, posisi, pub/sub). Kosongkan untuk memakai versi dalam memori (hanya satu proses).
REDIS_URL=

# Rahasia untuk menandatangani sesi & token real-time. Wajib diisi di produksi (minimal 32 karakter acak).
AUTH_SECRET=

# URL publik aplikasi, dipakai di tautan email (verifikasi, reset, undangan).
APP_URL=http://localhost:3000

# URL server WebSocket bila dipisah dari aplikasi web (misalnya di Vercel). Kosong = host yang sama, path /ws.
NEXT_PUBLIC_REALTIME_URL=

# SMTP untuk mengirim email, contoh: smtps://user:pass@smtp.example.com:465 . Kosong = tautan dicetak ke konsol.
SMTP_URL=

# Verifikasi email: mati secara bawaan. Isi "on" untuk mengirim email verifikasi saat daftar.
EMAIL_VERIFICATION=
MAIL_FROM="Meetopia <no-reply@example.com>"

# Server ICE untuk WebRTC (JSON). Default memakai STUN publik Google.
NEXT_PUBLIC_ICE_SERVERS=
